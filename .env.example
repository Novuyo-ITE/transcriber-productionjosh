# Django Configuration
SECRET_KEY="your-random-django-secret-key-here"
DEBUG="False"
ALLOWED_HOSTS="*"

# Railway PostgreSQL (Automatically populated by Railway when you attach Postgres)
# DATABASE_URL="postgresql://user:pass@host:port/dbname"

# RunPod Serverless GPU Inference (From your RunPod Console)
RUNPOD_API_KEY="your_runpod_api_key_here"
RUNPOD_ENDPOINT_ID="your_runpod_endpoint_id_here"

# Google Gemini API Key (For AI Co-Pilot chat, Q&A, and dialogue formatting)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional Hugging Face Token (if accessing gated HuggingFace models)
# HF_TOKEN=""
